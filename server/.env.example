# Token del bot (Discord Developer Portal > tu app > Bot > Reset Token)
DISCORD_TOKEN=

# Direccion publica del relay, se muestra en /vincular para copiarla en la extension
PUBLIC_URL=wss://radio.tudominio.cl/stream

# Opcionales
PORT=8790
# Retraso maximo que se acumula en el servidor antes de descartar audio viejo (ms)
MAX_BUFFER_MS=400
# Audio que se junta antes de empezar a sonar (ms)
PREBUFFER_MS=100
